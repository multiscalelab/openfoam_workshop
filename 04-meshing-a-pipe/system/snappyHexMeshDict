FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    regionSTL.stl
    {
        type    triSurfaceMesh;
        regions
        {
            inlet   { name inlet; }
            outlet  { name outlet; }
            wall    { name wall; }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      1000000;
    minRefinementCells  0;
    nCellsBetweenLevels 3;

    features
    (
        {
            file    "regionSTL.eMesh";
            level   0;
        }
    );

    // The uniform background grid already resolves the cross-section.
    refinementSurfaces
    {
        regionSTL.stl
        {
            level (0 0);
            regions
            {
                inlet   { level (0 0); patchInfo { type patch; } }
                outlet  { level (0 0); patchInfo { type patch; } }
                wall    { level (0 0); patchInfo { type wall; } }
            }
        }
    }

    resolveFeatureAngle 30;
    refinementRegions {}

    // Keep the connected fluid volume containing this point.
    locationInMesh (0.0007 0.0003 0.08);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch           3;
    tolerance              1.0;
    nSolveIter             100;
    nRelaxIter             5;
    nFeatureSnapIter       5;
    implicitFeatureSnap    false;
    explicitFeatureSnap    true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    // With relativeSizes disabled, layer thicknesses are in metres.
    relativeSizes false;
    layers
    {
        wall
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio             1.2;
    finalLayerThickness        0.00065;
    minThickness               0.0001;
    nGrow                      0;
    featureAngle               80;
    nRelaxIter                 5;
    nSmoothSurfaceNormals      1;
    nSmoothNormals             3;
    nSmoothThickness           10;
    maxFaceThicknessRatio      0.5;
    maxThicknessToMedialRatio  0.3;
    minMedialAxisAngle         90;
    nBufferCellsNoExtrude      0;
    nLayerIter                 50;
    nRelaxedIter               20;
}

meshQualityControls
{
    #include "meshQualityDict"
    relaxed
    {
        maxNonOrtho 65;
    }
    nSmoothScale   4;
    errorReduction 0.75;
}

writeFlags (scalarLevels layerSets layerFields);
mergeTolerance 1e-6;
