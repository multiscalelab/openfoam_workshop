FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}

type                sets;
libs                (sampling);
setFormat           raw;
interpolationScheme cellPointFace;
fields              (U p);

sets
{
    centreline
    {
        type        uniform;
        axis        x;
        start       (0.05 0 0.05);
        end         (9.95 0 0.05);
        nPoints     100;
    }

    downstreamProfile
    {
        type        uniform;
        axis        y;
        start       (9 -0.49 0.05);
        end         (9  0.49 0.05);
        nPoints     99;
    }
}
