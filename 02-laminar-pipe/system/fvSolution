FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver                  GAMG;
        smoother                GaussSeidel;
        tolerance               1e-6;
        relTol                  0.01;
        nPreSweeps              0;
        nPostSweeps             2;
        agglomerator            faceAreaPair;
        nCellsInCoarsestLevel   100;
    }

    pFinal
    {
        $p;
        relTol                  0;
    }

    U
    {
        solver                  PBiCGStab;
        preconditioner          DILU;
        tolerance               1e-8;
        relTol                  0;
    }
}

PISO
{
    nCorrectors                 1;
    nNonOrthogonalCorrectors    0;
}
